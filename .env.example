# Copy this file to .env and fill in real values.
# Never commit .env — it is ignored by git.

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# HMAC secret for confirm/reschedule links (falls back to the service role key)
BOOKING_ACTION_SECRET=

# ── Email (Brevo primary, Resend fallback) ──────────────────
BREVO_API_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_FROM_EMAIL=
EMAIL_PROVIDER=brevo

# ── Payments ────────────────────────────────────────────────
# Encrypts per-business PayMongo keys at rest
PAYMENTS_ENCRYPTION_KEY=

# ── Crons ───────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ── AI (free Gemini API key: https://aistudio.google.com) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
